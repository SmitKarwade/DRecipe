<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="newrecipe"
            type="com.example.drecipe.Recipe" />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddNewRecipe">

    <TextView
        android:id="@+id/f3textView6"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/boogaloo"
        android:padding="4dp"
        android:text="Category :"
        android:textColor="#494949"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/f3textView5"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/f3save"
        android:layout_width="74dp"
        android:layout_height="35dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/transparent"
        android:fontFamily="@font/amaranth"
        android:text="Save"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <AutoCompleteTextView
        android:id="@+id/f3_category"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/edit_text_back"
        android:gravity="start"
        android:padding="10dp"
        android:text="@={newrecipe.category}"
        android:textColor="#656565"
        app:layout_constraintEnd_toEndOf="@+id/f3editText"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/f3textView6"
        app:layout_constraintTop_toBottomOf="@+id/f3editText" />

    <AutoCompleteTextView
        android:id="@+id/f3_note"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/edit_text_back"
        android:gravity="start"
        android:padding="10dp"

        android:text="@={newrecipe.note}"
        android:textColor="#656565"
        app:layout_constraintEnd_toEndOf="@+id/f3_category"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/f3textView5"
        app:layout_constraintTop_toBottomOf="@+id/f3_category" />

    <TextView
        android:id="@+id/f3textView5"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/boogaloo"
        android:padding="4dp"
        android:text="Note :"
        android:textColor="#494949"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/f3_note"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/f3editText"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edit_text_back"
        android:ems="10"
        android:gravity="start"
        android:inputType="text"
        android:padding="10dp"
        android:text="@={newrecipe.title}"
        android:textColor="#656565"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/f3textView7"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/f3RecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/f3textView8"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/f3textView7"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="88dp"
        android:fontFamily="@font/boogaloo"

        android:padding="4dp"
        android:text="Name :"
        android:textColor="#494949"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/f3textView6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.244" />

    <Button
        android:id="@+id/f3addbtn"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/addlist"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/f3textView8"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="92dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/f1_text"
        android:fontFamily="@font/boogaloo"
        android:gravity="center"
        android:text="Name"
        android:textColor="#3A3A3A"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView11" />

    <TextView
        android:id="@+id/f3textView9"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:background="@drawable/f1_text"
        android:fontFamily="@font/boogaloo"
        android:gravity="center"
        android:text="Qty"
        android:textColor="#3A3A3A"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/f3textView8"
        app:layout_constraintEnd_toStartOf="@+id/f3textView10"
        app:layout_constraintHorizontal_bias="0.781"
        app:layout_constraintStart_toEndOf="@+id/f3textView8"
        app:layout_constraintTop_toTopOf="@+id/f3textView8"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/f3textView10"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/f1_text"
        android:fontFamily="@font/boogaloo"
        android:gravity="center"
        android:text="Unit"
        android:textColor="#3A3A3A"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/f3textView9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/f3textView9"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/boogaloo"
        android:gravity="center"
        android:text="Ingredients"
        android:textColor="#494949"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/f3textView5" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>